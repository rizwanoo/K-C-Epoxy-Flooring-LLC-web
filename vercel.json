{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|images/|assets/|favicon|apple-touch-icon|manifest\\.webmanifest|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
